<?xml version="1.0" encoding="utf-8"?>
<!--
    Belt-and-braces: even though android:allowBackup="false" turns off
    Auto Backup, Android 12+ uses these data-extraction rules for both
    cloud (Google Drive) and device-to-device transfers. Excluding
    everything is the right default for a recovery app — user data must
    not leak via Google's backup infrastructure.

    Users who want their data on a new device use the in-app Export /
    Import flow instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
